{
  "manifest_version": 3,
  "name": "PR Sift",
  "version": "1.0.0",
  "description": "Review large GitHub pull requests faster: smart file filters, viewed tracking and private notes. Not affiliated with GitHub.",
  "homepage_url": "https://pr-sift.haythamasalama.me/",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/*", "https://patch-diff.githubusercontent.com/*"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dist/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PR Sift settings"
  }
}
