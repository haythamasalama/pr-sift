{
  "name": "@pr-sift/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Review large GitHub pull requests faster: smart file filters, viewed tracking and private notes. Not affiliated with GitHub.",
  "license": "MIT",
  "scripts": {
    "build": "vite build -c vite.content.config.ts && vite build -c vite.background.config.ts && vite build -c vite.options.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.70.0",
    "@pr-sift/core": "workspace:*",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "highlight.js": "^11.12.0",
    "reka-ui": "^2.11.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
