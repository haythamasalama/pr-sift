{
  "name": "@pr-sift/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PR Sift for the desktop: review pull requests and clean up worktrees and build leftovers.",
  "author": "Haytham A. Salama (https://haythamasalama.me/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/haythamasalama/pr-sift.git",
    "directory": "apps/desktop"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "smoke": "electron-vite build && node tests/e2e/smoke.mjs"
  },
  "devDependencies": {
    "@lucide/vue": "^1.77.0",
    "@pr-sift/core": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
