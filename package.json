{
  "name": "pr-sift-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Review large GitHub pull requests faster: smart file filters, viewed tracking and private notes. Not affiliated with GitHub.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm --filter @pr-sift/extension build",
    "package": "pnpm --filter @pr-sift/extension package",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.2"
  }
}
