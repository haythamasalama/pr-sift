{
  "manifest_version": 3,
  "name": "Review Lens",
  "version": "0.1.0",
  "description": "Fast, customizable pull request review on top of GitHub.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/*", "https://patch-diff.githubusercontent.com/*"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dist/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Review Lens settings"
  }
}
